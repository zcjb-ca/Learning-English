# Copy these names into your Vercel project's Environment Variables.
# Do NOT put real secrets in this file or commit them — this is only a template.

# === AI 凭据：方案 A 与方案 B 二选一 ===
# 方案 A（自购 Anthropic 账号）：只填官方 key，下面的 BASE_URL / AUTH_TOKEN 留空。
# 方案 B（公司提供的网关）：填公司给的 base URL + token：
#   - ANTHROPIC_BASE_URL 填到「<它>/v1/messages 是正确地址」为准（通常是不带 /v1 的根地址）。
#   - token 二选一：网关用 x-api-key 就填 ANTHROPIC_API_KEY；用 Authorization: Bearer 就填 ANTHROPIC_AUTH_TOKEN。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# 可选：仅当网关的模型名与官方不同时才填，覆盖默认模型 id（留空用官方默认）。
MODEL_FEEDBACK=
MODEL_INGEST=
MODEL_CHEAP=

# The single shared password you'll type to log in. Choose something long.
APP_PASSWORD=

# A long random string used to sign your login cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Postgres connection string. If you add Neon from the Vercel Marketplace,
# Vercel injects this automatically and you can leave it blank here.
DATABASE_URL=

# Vercel Blob read-write token. Stores the lesson audio so the browser can upload
# it directly (bypassing the function body-size limit). After you connect a Blob
# store in the Vercel dashboard, Vercel injects this automatically; for local dev
# run `vercel env pull` to fetch it.
BLOB_READ_WRITE_TOKEN=
